# =====================================================================================================================
# Sales-Portal – Umgebungsvariablen
# Lokal: Datei nach `.env` kopieren ist NICHT nötig – ohne Angaben läuft alles im Demo-Modus
#        (PGlite, Mock-Integrationen, Dev-Login). `npm run dev` liest keine .env automatisch; Variablen bei Bedarf
#        in der Shell setzen. docker compose liest `.env` im Projektordner.
# Geheimnisse: immer als <NAME>_FILE (Docker-Secret) übergeben, nie im Klartext in .env für Prod.
# =====================================================================================================================

# --- Laufzeit ---------------------------------------------------------------------------------------------------------
# development | production | test. In production verweigert der Server unsichere Konfigurationen.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Adresse, wie der Browser das Portal sieht (Redirect-URI, Origin-Prüfung). Prod: https://…  Dev-Standard: http://localhost:5173
PUBLIC_URL=
# Weitere erlaubte Origins für die CSRF-Prüfung (Komma-getrennt), selten nötig.
ALLOWED_ORIGINS=
# Reverse Proxy davor: seine Adresse(n), wie die App sie sieht (IP/CIDR, Komma-getrennt; Proxy auf dem Docker-Host:
# Gateway des Compose-Netzes, z.B. 172.18.0.1). Dann gilt der rechte X-Forwarded-For-Eintrag, den nicht der Proxy
# geschrieben hat – vom Client vorangestellte Einträge zählen nicht. «true» (allen vertrauen) wird abgelehnt.
# Rate-Limits zählen angemeldete Anfragen pro Benutzer, anonyme (Anmeldung) pro IP.
# AUTH_MODE=dev verlangt HOST=127.0.0.1/localhost und PUBLIC_URL auf localhost.
TRUST_PROXY=false
LOG_LEVEL=info
# Umgebung in der Kopfleiste: Demo | Sandbox | Prod
ENVIRONMENT_LABEL=Demo
# Komma-getrennte Feature-Flags, z.B. callbackDetection,weeklyReport
FEATURE_FLAGS=

# --- Datenbank --------------------------------------------------------------------------------------------------------
# Leer = PGlite (eingebettetes Postgres, Daten in PGLITE_DIR). Prod: Postgres 16.
DATABASE_URL=
# Passwort separat (wird in DATABASE_URL eingesetzt) – in Docker: DATABASE_PASSWORD_FILE=/run/secrets/db_password
DATABASE_PASSWORD=
DATABASE_PASSWORD_FILE=
DATABASE_SSL=false
PGLITE_DIR=./data/pglite
# PGlite in production nur mit ausdrücklicher Erlaubnis (nicht empfohlen)
ALLOW_PGLITE_IN_PRODUCTION=false

# --- Anmeldung & Sessions ----------------------------------------------------------------------------------------------
# dev = Login-Seite mit Seed-Benutzern (in production verboten) | entra = Microsoft Entra ID (OIDC + PKCE)
AUTH_MODE=dev
# mind. 32 Bytes Zufall, z.B.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_SECRET_FILE=
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
# 32 Byte Schlüssel (base64 oder 64 Hex-Zeichen) für AES-256-GCM-verschlüsselte Tokens (Pflicht bei AUTH_MODE=entra):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_FILE=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_CLIENT_SECRET_FILE=
ENTRA_SCOPES=openid profile email offline_access User.Read
# Anmeldenamen (UPN, nicht die Mail-Adresse) von Mitgliedern des Tenants, die beim ERSTEN Entra-Login die Rolle Admin
# erhalten (oder solange es keinen aktiven Admin gibt). Danach Rollen im Portal pflegen. Gäste (B2B) nie.
BOOTSTRAP_ADMIN_EMAILS=

# --- Integrationen (Adapter) -------------------------------------------------------------------------------------------
# mock | live – global, mit Überschreibung pro Adapter
INTEGRATIONS=mock
CRM_ADAPTER=
CALENDAR_ADAPTER=
MAIL_ADAPTER=
AI_ADAPTER=
TRANSCRIPT_ADAPTER=
TELEPHONY_ADAPTER=
# Mock-Adapter in production nur mit dieser Freigabe (z.B. Demo-Server)
ALLOW_MOCK_IN_PRODUCTION=false
# Demo-Daten (~400 erfundene Leads) beim Start anlegen, wenn CRM=mock und die Mock-Tabellen leer sind
SEED_DEMO_DATA=true

# Dataverse (CRM) – z.B. https://<org>.crm4.dynamics.com
DATAVERSE_URL=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
AI_MODEL_ANALYSIS=claude-opus-5-5
AI_MODEL_MAIL=claude-sonnet-5-5

# Vera (Transkripte) – Weg noch offen
VERA_API_URL=
VERA_API_KEY=
VERA_API_KEY_FILE=

# Ausserhalb Prod gehen ALLE Kunden-Mails an diese Adresse (bzw. in den Mock-Postausgang)
MAIL_TEST_RECIPIENT=

# --- Live-Anbindung Dataverse / Graph (README «Live-Anbindung») ---------------------------------------------------------
# App-Zugang für Hintergrundjobs: ENTRA_CLIENT_SECRET(_FILE) oder Zertifikat (PEM, empfohlen) – nur als Docker-Secret
ENTRA_CLIENT_CERT_FILE=
ENTRA_CLIENT_KEY_FILE=
ENTRA_AUTHORITY_HOST=login.microsoftonline.com
# auto | refresh_token | obo  (obo nur, wenn ENTRA_SCOPES api://<client-id>/access_as_user anfordert)
ENTRA_DELEGATED_FLOW=auto
# Postfächer, die das Portal über Graph nutzen darf (Komma-getrennt). Ohne Liste kein App-Zugriff auf Postfächer.
GRAPH_ALLOWED_MAILBOXES=
# Absender für Hintergrund-Mails (Briefing, Wochenreport), muss in GRAPH_ALLOWED_MAILBOXES stehen
GRAPH_APP_MAIL_SENDER=
GRAPH_DELTA_PAST_DAYS=7
GRAPH_DELTA_FUTURE_DAYS=180
# systemuser-IDs (GUID), deren E-Mail-Aktivitäten Kampagnen-Mails sind (Lemlist-Flow)
DATAVERSE_CAMPAIGN_SENDER_IDS=
DATAVERSE_BOOKING_ENTITY_SET=kls_buchungs
LIVE_HTTP_TIMEOUT_MS=30000

# --- Worker ---------------------------------------------------------------------------------------------------------------
# Jobs im API-Prozess ausführen (mit PGlite immer an, da PGlite nur einen Prozess erlaubt)
WORKER_EMBEDDED=false
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=4

# --- Web --------------------------------------------------------------------------------------------------------------
# Verzeichnis des gebauten Webs (Standard: apps/web/dist)
WEB_DIST_DIR=

# --- docker compose ---------------------------------------------------------------------------------------------------
# Bind-Adresse/Port des App-Containers auf dem Host (TLS-Reverse-Proxy davor)
APP_BIND=127.0.0.1
APP_PORT=3000
